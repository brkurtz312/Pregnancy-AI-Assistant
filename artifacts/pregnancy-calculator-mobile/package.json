{
  "name": "@workspace/pregnancy-calculator-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=${PREGNANCY_CLERK_PUBLISHABLE_KEY:-$CLERK_PUBLISHABLE_KEY} EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=$REVENUECAT_TEST_API_KEY EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=$REVENUECAT_IOS_API_KEY EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=$REVENUECAT_ANDROID_API_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "test": "jest --forceExit --maxWorkers=2",
    "typecheck": "node scripts/check-native-imports.js && node scripts/check-watch-sync.js && tsc -p tsconfig.json --noEmit",
    "check:watch-sync": "node scripts/check-watch-sync.js",
    "check:watch-sync:fix": "node scripts/check-watch-sync.js --fix",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "validate:provisioning": "node scripts/validate-eas-provisioning.js",
    "validate:watch-icons": "node scripts/validate-watch-icon-format.js",
    "validate:ios-icons": "node scripts/validate-ios-icon-format.js",
    "cancel-stale-builds": "node scripts/cancel-stale-eas-builds.js",
    "cancel-stale-builds:dry-run": "node scripts/cancel-stale-eas-builds.js --dry-run",
    "eas-build-pre-install": "node scripts/validate-eas-provisioning.js",
    "eas-build-post-install": "node scripts/validate-watch-icon-format.js && node scripts/validate-ios-icon-format.js"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/test-helpers/jest-resolver.js",
    "moduleNameMapper": {
      "^test-renderer$": "<rootDir>/node_modules/react-test-renderer",
      "^test-renderer/(.*)$": "<rootDir>/node_modules/react-test-renderer/$1",
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "58.1.19",
    "@expo/config-plugins": "~58.0.12",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "~19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~58.0.24",
    "eas-cli": "27.5.0",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.9.2",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@clerk/expo": "^4.15.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@workspace/learn-content-ids": "workspace:*",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-modules-autolinking": "~58.0.17",
    "expo-notifications": "~58.1.8",
    "expo-print": "~58.0.8",
    "expo-sharing": "~58.0.22",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^10.16.0",
    "react-native-webview": "14.0.1",
    "watch-connectivity": "workspace:*"
  }
}
