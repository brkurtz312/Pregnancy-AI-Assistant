{
  "expo": {
    "name": "Pregnancy AI Assistant",
    "slug": "pregnancy-calculator-mobile",
    "version": "1.0.17",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/8d9ddefc-b718-432f-9c1d-6bb44a7ea9d8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.17",
    "icon": "./assets/images/icon.png",
    "scheme": "pregnancy-calculator-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF5F7"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "bundleIdentifier": "app.replit.pregnancycalculator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSRequiresIPhoneOS": false,
        "UIDeviceFamily": [1, 2],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "app.replit.pregnancycalculator"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-updates",
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "forceStaticLinking": [
              "RNCAsyncStorage",
              "RNDateTimePicker",
              "RNGestureHandler",
              "RNPurchases",
              "RNReanimated",
              "RNScreens",
              "RNWorklets",
              "react-native-keyboard-controller",
              "react-native-netinfo",
              "react-native-safe-area-context"
            ],
            "extraPods": [
              {
                "name": "AppCheckCore",
                "modular_headers": true
              },
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": true
        }
      ],
      "./plugins/withWatchExtension",
      "./plugins/withAppleSignIn",
      "./plugins/withValidateIOSIconCatalog"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8d9ddefc-b718-432f-9c1d-6bb44a7ea9d8",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "PregnancyWatchApp",
                  "bundleIdentifier": "app.replit.pregnancycalculator.watchapp",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.replit.pregnancycalculator"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "brkurtz"
  }
}
