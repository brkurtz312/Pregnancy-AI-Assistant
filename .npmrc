auto-install-peers=false
strict-peer-dependencies=false

verify-deps-before-run=false

# Do not let pnpm install its own pinned version on the fly. package.json's
# packageManager field still pins 10.33.0 — CI reads it through
# pnpm/action-setup, which is where the version actually needs enforcing.
#
# Without this, pnpm tries `pnpm add pnpm@10.33.0` whenever the running version
# differs. That works on a laptop and on GitHub's runners, and fails in the
# Replit workspace, where the self-install aborts and retries in a loop until
# the command dies. Nothing in the repository needs pnpm to manage itself.
manage-package-manager-versions=false
