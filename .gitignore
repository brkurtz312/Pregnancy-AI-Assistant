# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# EAS / Fastlane build logs pasted into attached_assets — generated artefacts,
# not source files; should never be committed.
attached_assets/Pasted-*.txt

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Stray git internals swept up by auto-commit
FETCH_HEAD
ORIG_HEAD

# Database dumps. The migration runbook has you write these into the repo root
# (docs/db-migration.md), and they hold real user data -- the production tables
# verbatim. Untracked is not the same as ignored: untracked, one `git add -A`
# puts patient data in the history for good.
#
# The exceptions are for a schema change this project has not made yet. Nothing
# tracked matches *.sql today because drizzle-kit `push` applies the schema
# directly. Switching to `generate` would start emitting migration files, and
# without these lines they would be ignored silently -- a schema that never
# reaches another machine, with nothing to see in `git status`.
*.sql
!lib/db/**/*.sql
!**/migrations/*.sql
